# Канонический домен (Q1). Используется в canonical, hreflang, OG, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://palisoft.ru

# Q5: рубильник индексации, открыто/закрыто для всех сразу.
# false (по умолчанию): robots.txt отдаёт Disallow: /, на каждой странице
# <meta name="robots" content="noindex, nofollow">, sitemap.xml пустой.
# true: сайт открыт всем краулерам, sitemap опубликован.
#
# Значение впекается в HTML на сборке (SSG) — смена требует ПЕРЕСБОРКИ
# и передеплоя, а не рестарта. На запуске сайта не забыть поставить true.
ALLOW_INDEXING=false
