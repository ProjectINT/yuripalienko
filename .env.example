# Канонический домен (Q1). Используется в canonical, hreflang, OG, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://palisoft.ru

# Q5: глобальный рубильник индексации. По умолчанию выключен: robots.txt отдаёт
# Disallow: /, на каждой странице <meta name="robots" content="noindex, nofollow">,
# sitemap.xml пустой. Значение впекается в HTML на сборке (SSG) — смена требует
# ПЕРЕСБОРКИ и передеплоя, а не рестарта.
ALLOW_INDEXING_BOTS=false

# Прод-сборка с noindex падает с ошибкой (см. next.config.ts), пока вы явно
# не подтвердите, что это намеренно. До запуска деплойте с этим флагом;
# на запуске: ALLOW_INDEXING_BOTS=true, этот флаг убрать, пересобрать, передеплоить.
ALLOW_NOINDEX_BUILD=true
